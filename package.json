{
  "name": "dsh-model-effort-chips",
  "version": "1.30.0",
  "private": true,
  "description": "Split DeepSeek Harness's composer model seat into a model chip and a reasoning-effort chip with a draggable, wheel-adjustable slider. Works on macOS and Windows.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./assets/*": "./lib/assets/*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.cmd",
    "install.ps1",
    "uninstall.cmd",
    "uninstall.ps1",
    "verify.cmd",
    "verify.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/client-load.mjs && node test/render.mjs && node test/wheel.mjs && node test/effect-kunpeng.mjs && node test/effect-menu.mjs && node test/effects-all.mjs && node test/effect-art.mjs && node test/install.mjs && node scripts/assemble-effects.mjs --check",
    "test:load": "node test/client-load.mjs",
    "test:render": "node test/render.mjs",
    "test:wheel": "node test/wheel.mjs",
    "test:effect": "node test/effect-kunpeng.mjs",
    "test:menu": "node test/effect-menu.mjs",
    "test:install": "node test/install.mjs",
    "harness": "node scripts/effect-harness.mjs",
    "test:effects": "node test/effects-all.mjs",
    "assemble": "node scripts/assemble-effects.mjs",
    "install:local": "node scripts/install.mjs",
    "uninstall:local": "node scripts/uninstall.mjs",
    "verify:live": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "ui",
    "reasoning-effort",
    "model-selector",
    "windows"
  ],
  "author": "Dreamaniax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dreamaniax/dsh-model-effort-chips.git"
  },
  "homepage": "https://github.com/Dreamaniax/dsh-model-effort-chips#readme",
  "bugs": {
    "url": "https://github.com/Dreamaniax/dsh-model-effort-chips/issues"
  }
}
