{
  "name": "dsh-model-effort-chips",
  "version": "1.5.1",
  "private": true,
  "description": "Split DeepSeek Harness's composer model seat into a model chip and a reasoning-effort chip with a draggable, wheel-adjustable slider.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/client-load.mjs && node test/render.mjs && node test/wheel.mjs",
    "test:load": "node test/client-load.mjs",
    "test:render": "node test/render.mjs",
    "test:wheel": "node test/wheel.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "ui",
    "reasoning-effort",
    "model-selector"
  ],
  "author": "dreamania",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<your-name>/dsh-model-effort-chips.git"
  },
  "homepage": "https://github.com/<your-name>/dsh-model-effort-chips#readme",
  "bugs": {
    "url": "https://github.com/<your-name>/dsh-model-effort-chips/issues"
  }
}
