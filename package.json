{
  "name": "dsh-model-effort-chips",
  "version": "1.4.0",
  "private": true,
  "description": "Split the DSH composer model seat into a model chip and a reasoning-effort chip whose popover is a draggable effort slider.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/client-load.mjs && node test/render.mjs",
    "test:load": "node test/client-load.mjs",
    "test:render": "node test/render.mjs"
  }
}
